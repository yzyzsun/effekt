// Three nested handlers share the source name h. Aliases retain identity.
// Calls target the innermost, middle, and outer instances, respectively.
def main(): Bool = {
  try {
    val saved = cap(h);
    try {
      val middle = cap(h);
      try {
        h.tick();
        middle.tick();
        saved.ask()
      } with h: Int / (Int => Int / (Int => Bool)) {
        def tick(): Unit /
          (Int / (Int => Int / (Int => Bool)) =>
           Int / (Int => Int / (Int => Bool))) = {
          val n = resume();
          n + 10
        }
        return x => { x }
      }
    } with h: Int / (Int => Bool) {
      def tick(): Unit /
        (Int / (Int => Bool) => Int / (Int => Bool)) = {
        val n = resume();
        n + 100
      }
      return x => { x }
    }
  } with h: Bool {
    def ask(): Int / (Int => Bool) = {
      val n = resume(42);
      n == 152
    }
    return x => { x }
  }
}
