// The outer operation infers a Bool layer around an Int layer.
// The inner clauses negate and add 100; main evaluates to true.
def main(): Bool = {
  try {
    try {
      try {
        innermost.tick();
        inner.tick();
        outer.ask()
      } with innermost: Bool / (Int => Int / (Int => Bool)) {
        def tick(): Unit /
          (Bool / (Int => Int / (Int => Bool)) =>
           Bool / (Int => Int / (Int => Bool))) = {
          val b = resume();
          !b
        }
        return x => { x == 42 }
      }
    } with inner: Int / (Int => Bool) {
      def tick(): Unit /
        (Int / (Int => Bool) => Int / (Int => Bool)) = {
        val n = resume();
        n + 100
      }
      return b => { if (b) { 1 } else { 0 } }
    }
  } with outer: Bool {
    def ask(): Int / (Int => Bool) = {
      val n = resume(42);
      n == 100
    }
    return x => { x }
  }
}
