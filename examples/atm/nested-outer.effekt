// The outer operation crosses the inner delimiter. Both answer layers matter.
def main(): Bool = {
  try {
    try {
      outer.ask()
    } with inner {
      def tick(): Unit / (Int / (Int => Bool) => Int / (Int => Bool)) = {
        resume()
      }
      return x => {
        x
      }
    }: Int / (Int => Bool)
  } with outer {
    def ask(): Int / (Int => Bool) = {
      val n = resume(42);
      zero(n)
    }
    return x => {
      x
    }
  }
}
