// Pinned coar ARM: deferred-1-SAT.ml. The thunk is stored and forced in the handler.
// Helpers use exact top-region arrows; the supplied thunk remains an ordinary arrow.
data Deferred { Value(value: Int); Thunk(context: Int, thunk: ((Unit) => {v: Int | v == context})) }
measure content(s: Deferred): Int {
  case Value(v) => v; case Thunk(c,f) => c;
}
def main(): Bool = {
  def test(r: Int) at [top]: ((thunk: ((Unit) => {v: Int | v == r})) =>[top] {v: Int | v == r}) = {
    fun (thunk: ((Unit) => {v: Int | v == r})) at [top]: {v: Int | v == r} {
      val run = try {
        val result = lazyValue.force(); result
      } with lazyValue: ((s: {d: Deferred | content(d) == r}) =>[top] {v: Int | v == r}) {
        def force(): {v: Int | v == r} /
          (((s: Deferred) =>[top] {v: Int | v == r}) =>
           ((s: {d: Deferred | content(d) == r}) =>[top] {v: Int | v == r})) = {
          fun (s: {d: Deferred | content(d) == r}) at [top]: {v: Int | v == r} {
            match (s) {
              case Value(v) => { val next = resume(v); next(Value(v)) }
              case Thunk(c,f) => { val v = f(); val next = resume(v); next(Value(v)) }
            }
          }
        }
        return y => { fun (s: Deferred) at [top]: {v: Int | v == y} { y } }
      };
      run(Thunk(r,thunk))
    }
  }
  val run = test(7);
  val result = run(fun (): {v: Int | v == 7} { 7 }); result == 7
}
