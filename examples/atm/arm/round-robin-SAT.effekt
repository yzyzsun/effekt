// Pinned coar ARM: round-robin-SAT.ml.
// Explicit scheduler state replaces the private queue/counter references.
// Yield/Spawn store actual captured continuations. Increment is reified so the
// shared counter advances when the scheduler executes that thread's step.
// Child handlers are reified separately; dequeue and FIFO scheduling are explicit.
data Thread {
  Done();
  Increment(next: ((Unit) =>[top] Thread));
  Yielded(next: ((Unit) =>[top] Thread));
  Spawned(child: ((Unit) =>[top] Thread), next: ((Unit) =>[top] Thread))
}
data Queue { Empty(); Enqueued(task: ((Unit) =>[top] Thread), tail: Queue) }
def main(): Bool = {
  type TaskRegion = ((Unit) =>[top] Unit);
  def rec appendQueue(q: Queue) at [top]: ((rest: Queue) =>[top] Queue) = {
    fun (rest: Queue) at [top]: Queue {
      match (q) {
        case Empty() => { rest }
        case Enqueued(task,t) => { val appendRest = appendQueue(t); val tail = appendRest(rest); Enqueued(task,tail) }
      }
    }
  }
  def rec schedule(work: (Thread,Queue)) at [top]: ((count: Int) =>[top] {r: Int | r >= count}) = {
    fun (count: Int) at [top]: {r: Int | r >= count} {
      match (fst(work)) {
        case Done() => {
          match (snd(work)) {
            case Empty() => { count }
            case Enqueued(task,tail) => { val active = task(); val run = schedule((active,tail)); run(count) }
          }
        }
        case Increment(next) => { val active = next(); val run = schedule((active,snd(work))); run(count+1) }
        case Yielded(next) => {
          val append = appendQueue(snd(work)); val queue = append(Enqueued(next,Empty()));
          val run = schedule((Done(),queue)); run(count)
        }
        case Spawned(child,next) => {
          val append = appendQueue(snd(work)); val queue = append(Enqueued(next,Empty()));
          val active = child(); val run = schedule((active,queue)); run(count)
        }
      }
    }
  }
  def child() at [top]: Thread = {
    try {
      runtime.increment(); runtime.yield(); runtime.increment(); runtime.yield()
    } with runtime: Thread {
      def increment(): Unit / (Thread => Thread) = {
        Increment(fun () at [top]: Thread { resume() })
      }
      def yield(): Unit / (Thread => Thread) = {
        Yielded(fun () at [top]: Thread { resume() })
      }
      return u => { Done() }
    }
  }
  def test(init: Int) at [top]: {r: Int | r >= init} = {
    val parent = try {
      runtime.spawn(fun () at [TaskRegion]: Thread { child() });
      runtime.spawn(fun () at [TaskRegion]: Thread { child() })
    } with runtime: Thread {
      def spawn(thread: ((Unit) =>[top] Thread)): Unit / (Thread => Thread) = {
        Spawned(thread,fun () at [top]: Thread { resume() })
      }
      return u => { Done() }
    };
    val run = schedule((parent,Empty())); run(init)
  }
  val result = test(8); result == 12
}
