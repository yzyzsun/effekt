// Both capability regions are abstract. Without relative evidence and an ATC,
// the checker cannot reconstruct the operation's symbolic handler distance.
def main(): Bool = {
  val both = fun (c: { def ask(): Int / (Int => Bool); }) {
    fun (d: { def bump(): Int / (Int / (Int => Bool) => Int / (Int => Bool)); }) {
      fun (): Int / (Int / (Int => Int) => Int / (Int => Bool)) {
        val a = d.bump();
        val b = c.ask();
        (a + b)
      }
    }
  };
  try {
    try {
      val local = both(outer)(inner);
      local()
    } with inner: Int / (Int => Bool) {
      def bump(): Int / (Int / (Int => Bool) => Int / (Int => Bool)) = {
        resume(20)
      }
      return x => {
        x
      }
    }
  } with outer: Bool {
    def ask(): Int / (Int => Bool) = {
      val n = resume(22);
      zero(n)
    }
    return x => {
      x
    }
  }
}
