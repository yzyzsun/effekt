// The callback contract includes its answer transition, not only captures.
def main(): Bool = {
  try {
    def apply(f: ((Unit) =>[h] Int / (Int => Bool))) at [h]: Int / (Int => Bool) = {
      f()
    }
    apply(fun () at [h]: Int / (Int => Bool) {
      h.ask()
    })
  } with h: Bool {
    def ask(): Int / (Int => Bool) = {
      val n = resume(42);
      zero(n)
    }
    return x => {
      x
    }
  }
}
