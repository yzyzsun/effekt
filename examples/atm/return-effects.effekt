// The inner return clause invokes the outer capability outside the inner prompt.
def main(): Bool = {
  try {
    try {
      ()
    } with inner: Int / (Int => Bool) {
      def tick(): Unit / (Int / (Int => Bool) => Int / (Int => Bool)) = {
        resume()
      }
      return x => {
        outer.ask()
      }
    }
  } with outer: Bool {
    def ask(): Int / (Int => Bool) = {
      val n = resume(42);
      zero(n)
    }
    return x => {
      x
    }
  }
}
