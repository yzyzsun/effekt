// The helper's callback contract names its bound capability, not a concrete h.
def main(): Bool = {
  val apply = fun (c: { def ask(): Int / (Int => Bool); }) {
    fun (f: ((Unit) =>[c] Int / (Int => Bool))) at [c]: Int / (Int => Bool) {
      f()
    }
  };
  try {
    apply(h)(fun () at [h]: Int / (Int => Bool) {
      h.ask()
    })
  } with h: Bool {
    def ask(): Int / (Int => Bool) = {
      val n = resume(42);
      zero(n)
    }
    return x => {
      x
    }
  }
}
