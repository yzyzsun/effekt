def main(): Bool = {
  try {
    val callback = fun ()[K: ATC(dist(path(outer)))]: Int / (K[Int] => K[Bool]) {
      outer.ask[path(outer); K]()
    };
    try {
      callback[Int / (Int => [])]()
    } with inner: Int / (Int => Bool) {
      def unused(): Unit /
        (Int / (Int => Bool) => Int / (Int => Bool)) = {
        resume()
      }
      return x => { x }
    }
  } with outer: Bool {
    def ask(): Int / (Int => Bool) = {
      val n = resume(42);
      n == 42
    }
    return x => { x }
  }
}
