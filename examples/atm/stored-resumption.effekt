// The handler returns its continuation, which is invoked after the handler exits.
// Its latent answer contract is Int / pure, and its ambient context is top level.
def main(): Int = {
  val saved = try {
    h.suspend()
  } with h: ((Int) =>[top] Int) {
    def suspend(): Int / (Int => ((Int) =>[top] Int)) = {
      resume
    }
    return x => {
      x
    }
  };
  saved(42)
}
