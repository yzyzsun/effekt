// Accepted result-type-polymorphic example; the result is 42.
// Each callback declares its call ATC; the helper instantiates it with [].
// The symbolic-distance inference failure is infer/polymorphic-outer-call.effekt.
// Mock descriptors/read/close; no operating-system file access.
interface File {
  def read(): Int
  def close(): Unit
}

def main(): Int = {
  def readInt(c: Int) = { c }
  def closeFile(c: Int) = { () }
  val file = fun [R] {
    fun (c: Int) {
      fun (body: (f: File) => ((Unit)[K: ATC(dist(path(f)))] => R / (K[R] => K[R]) at {f})) {
        try {
          body(h)[[]]()
        } with h: File {
          def read() = {
            val x = readInt(c);
            resume(x)
          }
          def close() = {
            closeFile(c);
            resume()
          }
          return x => { x }
        }: R
      }
    }
  };
  val readNumber = file[Int](42);
  val n = readNumber(fun (f: File) {
    fun ()[K: ATC(dist(path(f)))]: Int / (K[Int] => K[Int]) {
      val x = f.read[path(f); K]();
      f.close[path(f); K]();
      x
    }
  });
  val checkNumber = file[Bool](35);
  val ok = checkNumber(fun (f: File) {
    fun ()[K: ATC(dist(path(f)))]: Bool / (K[Bool] => K[Bool]) {
      val x = f.read[path(f); K]();
      f.close[path(f); K]();
      x == 35
    }
  });
  if (ok) { n } else { 0 }
}
