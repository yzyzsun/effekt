// Supplemental p33: defer two calls, infer their minimum region, and reroute
// each call through a shared region/distance/evidence parameter.
def main(): Int = {
  def outer() = { () }
  try {
    val inner: ((Unit) => Unit) at {h} = fun (u) { () };
    def both() = { outer(); inner() }
    both(); 42
  } with h: Int {
    def unused(): Unit / (Int => Int) = { resume() }
    return x => { x }
  }
}
