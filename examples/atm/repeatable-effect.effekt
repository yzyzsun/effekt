// Equal answer endpoints express the required composition property explicitly.
// The pure callback is embedded in the identity transition by subsumption.
def main(): Int = {
  val twice = fun (c: { def ask(): Int / (Int => Int); }) {
    typefun [Answer] {
      fun (f: ((Unit) =>[c] Int / (Answer => Answer))) at [c]:
          Int / (Answer => Answer) {
        val a = f();
        val b = f();
        a + b
      }
    }
  };
  try {
    val localTwice = twice(h);
    val pureResult = localTwice[type Int](fun () at [h]: Int { 1 });
    val effectResult = localTwice[type Int](fun () at [h]: Int / (Int => Int) { h.ask() });
    pureResult + effectResult
  } with h: Int {
    def ask(): Int / (Int => Int) = {
      val n = resume(42);
      n + 1
    }
    return x => { x }
  }
}
