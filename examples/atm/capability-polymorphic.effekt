// One abstraction is checked outside either handler, then instantiated twice.
def main(): Bool = {
  val invoke = fun (c: { def ask(): Int / (Int => Bool); }) {
    fun () at [c]: Int / (Int => Bool) {
      c.ask()
    }
  };
  val first = try {
    invoke(h)()
  } with h: Bool {
    def ask(): Int / (Int => Bool) = {
      val n = resume(42);
      zero(n)
    }
    return x => {
      x
    }
  };
  try {
    invoke(h)()
  } with h: Bool {
    def ask(): Int / (Int => Bool) = {
      val n = resume(0);
      zero(n)
    }
    return x => {
      if (first) {
        1
      } else {
        x
      }
    }
  }
}
