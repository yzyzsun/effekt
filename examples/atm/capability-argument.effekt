// Passing a capability preserves its identity and full operation answer contract.
def main(): Bool = {
  try {
    def invoke(c: cap(h)) at [h]: Int / (Int => Bool) = {
      c.ask()
    }
    invoke(h)
  } with h: Bool {
    def ask(): Int / (Int => Bool) = {
      val n = resume(42);
      zero(n)
    }
    return x => {
      x
    }
  }
}
